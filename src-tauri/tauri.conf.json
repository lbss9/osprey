{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osprey",
  "version": "0.1.2",
  "identifier": "com.lluan.osprey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Osprey",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Luan Barbosa",
    "category": "DeveloperTool",
    "shortDescription": "A fast, beautiful database client",
    "longDescription": "Osprey is a lightweight desktop client for PostgreSQL, MySQL and Redis. Rust engine, Tauri shell, everything stored locally.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "PortugueseBR"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2MERCMUI2QzExMDMwOEYKUldTUE1CREJ0ckVONWpBRnVnZExkZ2g2UDN0QlRWM000dXRObmE0SWM4eWdiemFaZTZkMHAxekcK",
      "endpoints": [
        "https://github.com/lbss9/osprey/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
